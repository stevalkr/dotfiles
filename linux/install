#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=lib.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"

case "${1:-}" in
    -h|--help)
        printf '%s\n' 'Usage: ./linux/install [<id>]' \
            'Install a release (default: newest) from the local mirror and make it current.'
        exit 0 ;;
esac
(($# <= 1)) || die 'install takes at most one release id'

# Target checks ------------------------------------------------------------
[[ "$(uname -s) $(uname -m)" == 'Linux x86_64' ]] || die 'Linux x86_64 is required'
((EUID != 0)) || die 'refusing to run as root'
read -r libc version <<<"$(getconf GNU_LIBC_VERSION)"
[[ "$libc" == glibc ]] || die "glibc is required, found $libc"
IFS=. read -r major minor _ <<<"$version"
((major > 2 || (major == 2 && minor >= 28))) || die "glibc 2.28 or newer is required, found $version"
need python3 zstd sha256sum tar find
python3 -c 'import sys; sys.exit(sys.version_info < (3, 6))' || die 'Python 3.6 or newer is required'
tar --version | grep -q 'GNU tar' || die 'GNU tar is required'

dev_env_init
# Relocation pads into the builder's 128-character store prefix.
store=$dev_env/store
((${#store} <= 128)) || die "store path is longer than 128 characters: $store"

id=${1:-$(newest_release)}
[[ -n "$id" ]] || die 'no releases; run ./linux/unbundle first'
release=$dev_env/releases/$id
[[ "$id" =~ $id_re && -d "$release" ]] || die "no such release: $id"

# Install ------------------------------------------------------------------
(
    use_release_spack "$release"
    spack -e "$release" install --only-concrete --use-buildcache=only \
        --no-check-signature --fail-fast --show-log-on-error
    spack -e "$release" env view regenerate
    spack -e "$release" find --explicit --no-groups --format '{name} {prefix}' >"$release/.roots"
)

# public/bin: every root's commands except private interpreters ------------
public=$release/public
rm -rf -- "$public.tmp"
mkdir -p "$public.tmp/bin"
while read -r name prefix; do
    [[ " ${public_exclude_roots[*]} " != *" $name "* ]] || continue
    for command in "$prefix"/bin/*; do
        [[ -f "$command" && -x "$command" ]] || continue
        command=${command##*/}
        if [[ "$(head -c 2 -- "$prefix/bin/$command")" == '#!' ]]; then
            IFS= read -r shebang <"$prefix/bin/$command" || true
            [[ ! "$shebang" =~ ^\#!\ */usr/bin/env\ +python ]] || continue
        fi
        [[ ! "$command" =~ $public_forbidden_re ]] || die "$name would expose $command"
        [[ -e "$release/view/bin/$command" ]] || die "$command of $name is not in the view"
        if [[ -L "$public.tmp/bin/$command" ]]; then
            printf 'install: %s from %s is already public\n' "$command" "$name" >&2
            continue
        fi
        # Into the view, where Python entry points use the view's interpreter.
        ln -s "../../view/bin/$command" "$public.tmp/bin/$command"
    done
done <"$release/.roots"
rm -rf -- "$public"
mv -- "$public.tmp" "$public"

mkdir -p "${dev_env_link%/*}"
[[ -L "$dev_env_link" || ! -e "$dev_env_link" ]] || die "$dev_env_link exists and is not a link"
ln -sfn -- "$release" "$dev_env_link"
printf 'install: %s is current (%s)\n' "$id" "$dev_env_link"
