#!/usr/bin/env bash
set -euo pipefail
linux_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
case "${1:-}" in
    -h|--help) echo 'Usage: ./linux/local-install <linux-local.tar.zst> [target-home]'; exit 0 ;;
esac
(($# >= 1 && $# <= 2)) || { echo 'Usage: ./linux/local-install <archive> [target-home]' >&2; exit 2; }
[[ "$(uname -s)" == Linux && "$(uname -m)" == x86_64 ]] || { echo 'Linux x86-64 is required.' >&2; exit 2; }
archive=$(cd -- "$(dirname -- "$1")" && pwd -P)/$(basename -- "$1")
target_home=${2:-$HOME}
python3 - "$archive" <<'PY'
import hashlib, pathlib, sys
archive = pathlib.Path(sys.argv[1])
record = pathlib.Path(str(archive) + '.sha256').read_text().split()
if len(record) != 2 or record[1] != archive.name:
    raise SystemExit('invalid local archive checksum record')
digest = hashlib.sha256()
with archive.open('rb') as stream:
    for chunk in iter(lambda: stream.read(1024 * 1024), b''):
        digest.update(chunk)
if digest.hexdigest() != record[0]:
    raise SystemExit('local archive checksum mismatch')
PY
temporary=$(mktemp -d)
trap 'rm -rf -- "$temporary"' EXIT
zstd -dc "$archive" >"$temporary/local.tar"
python3 "$linux_root/scripts/local-data.py" install "$target_home" "$temporary/local.tar"
echo "Restored Linux runtime data in $target_home"
