#!/usr/bin/env bash
set -euo pipefail

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
enable_remote_login=false
stow_only=false
usage() {
  echo 'usage: ./bootstrap [--enable-remote-login | --stow-only]'
}
while [[ $# -gt 0 ]]; do
  case "$1" in
    --enable-remote-login) enable_remote_login=true ;;
    --stow-only) stow_only=true ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done
if $stow_only && $enable_remote_login; then
  echo '--stow-only cannot be combined with --enable-remote-login' >&2; exit 2
fi

case "$(uname -s)" in
  Darwin)
    [[ "$(uname -m)" == arm64 ]] || { echo 'macOS requires Apple Silicon.' >&2; exit 2; }
    platform=macos
    stow=/opt/homebrew/bin/stow
    stow_missing='Stow is missing; run ./bootstrap without --stow-only.'
    ;;
  Linux)
    $enable_remote_login && { echo '--enable-remote-login is only supported on macOS' >&2; exit 2; }
    platform=linux
    dev_env="$HOME/.local/share/dev-env"
    stow="$dev_env/public/bin/stow"
    stow_missing='Run ./linux/install first.'
    ;;
  *) echo 'Unsupported platform' >&2; exit 2 ;;
esac
packages=("$repo/home" "$repo/$platform/home")

# macOS ------------------------------------------------------------------------

provision_macos() {
  local runtime_root python_provider node_root
  eval "$(/opt/homebrew/bin/brew shellenv bash)"
  brew bundle --file "$repo/macos/Brewfile"

  runtime_root="${XDG_DATA_HOME:-$HOME/.local/share}/nvim"
  python_provider="$runtime_root/python"
  if [[ ! -x "$python_provider/bin/python" ]]; then
    uv python install 3.13
    uv venv --managed-python --python 3.13 "$python_provider"
  fi
  uv pip install --python "$python_provider/bin/python" \
    pynvim \
    jupyter-client \
    cairosvg \
    pnglatex \
    plotly \
    kaleido \
    pyperclip \
    nbformat \
    pillow \
    requests \
    websocket-client

  node_root="$runtime_root/node"
  export FNM_DIR="$node_root/fnm"
  eval "$(fnm env --shell bash)"
  fnm install --lts --use
  npm install --prefix "$node_root/packages" --no-save --no-package-lock \
    neovim \
    markdownlint-cli \
    @fsouza/prettierd \
    pyright
  mkdir -p "$node_root/bin"
  ln -sfn "$(node -p 'process.execPath')" "$node_root/bin/node"

  if $enable_remote_login; then
    "$repo/macos/defaults.sh" --enable-remote-login
  else
    "$repo/macos/defaults.sh"
  fi
}

# Linux ------------------------------------------------------------------------

# Desktop entries and icons of the current release, linked through
# releases/<id>; links into any release are dropped first. The view's files are
# absolute links into the store, which Stow refuses to stow.
stow_share() {
  local share dir file target
  share="$(cd -P "$dev_env" && pwd)/view/share"
  for dir in applications icons; do
    if [[ -d "$HOME/.local/share/$dir" ]]; then
      find "$HOME/.local/share/$dir" -type l -lname '*/dev-env/releases/*/view/share/*' -delete
    fi
    [[ -d "$share/$dir" ]] || continue
    while IFS= read -r -d '' file; do
      target="$HOME/.local/share/$dir/${file#"$share/$dir/"}"
      if [[ -e "$target" || -L "$target" ]]; then
        echo "Not linking $target: it already exists." >&2
        continue
      fi
      mkdir -p "${target%/*}"
      ln -s "$file" "$target"
    done < <(find "$share/$dir" ! -type d -print0)
  done
}

# Neovim state (undo, ShaDa, swap) is shared by every machine on the checkout;
# its data is the current release's prepared copy, so it follows ./linux/install.
link_nvim_dirs() {
  local state="$repo/linux/out/state/nvim"
  if [[ ! -e "$state" ]]; then
    mkdir -p "$(dirname "$state")"
    if [[ -d "$HOME/.local/state/nvim" && ! -L "$HOME/.local/state/nvim" ]]; then
      mv -- "$HOME/.local/state/nvim" "$state"
      echo "moved $HOME/.local/state/nvim to $state"
    else
      mkdir "$state"
    fi
  fi
  link_dir .local/state/nvim "$state"

  [[ -d "$dev_env/local/share/nvim" ]] ||
    { echo 'The current release has no Neovim data; run ./linux/install.' >&2; exit 1; }
  link_dir .local/share/nvim dev-env/local/share/nvim
}

# Shared -----------------------------------------------------------------------

backup_root=

# Move ~/$1 into this run's backup, snapshotting the files it links to.
backup() {
  local path="$HOME/$1"
  [[ -e "$path" || -L "$path" ]] || return 0
  if [[ -z "$backup_root" ]]; then
    mkdir -p "$HOME/.dotfiles-backup"
    backup_root=$(mktemp -d "$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S).XXXXXX")
  fi
  mkdir -p "$(dirname "$backup_root/$1")"
  if [[ -L "$path" ]]; then
    mv -- "$path" "$backup_root/$1"
  else
    cp -RLp "$path" "$backup_root/$1"
    rm -rf -- "$path"
  fi
  printf 'backed up %s\n' "$path"
}

link_dir() {
  local path="$HOME/$1" target=$2
  [[ -L "$path" && "$(readlink -- "$path")" == "$target" ]] && return 0
  backup "$1"
  mkdir -p "$(dirname "$path")"
  ln -sfn -- "$target" "$path"
  printf 'linked %s -> %s\n' "$path" "$target"
}

# Each package's ~/.config/<app> is replaced whole; any other file Stow would
# link is backed up unless it already resolves to the package's copy.
backup_conflicts() {
  local package source
  for package in "${packages[@]}"; do
    if [[ -d "$package/.config" ]]; then
      while IFS= read -r -d '' source; do
        backup ".config/${source##*/}"
      done < <(find "$package/.config" -mindepth 1 -maxdepth 1 -print0)
    fi
    while IFS= read -r -d '' source; do
      [[ "$HOME/${source#"$package/"}" -ef "$source" ]] || backup "${source#"$package/"}"
    done < <(find "$package" ! -type d -print0)
  done
}

# Main -------------------------------------------------------------------------

if ! $stow_only; then
  [[ "$platform" == macos ]] && provision_macos
  backup_conflicts
fi

[[ -x "$stow" ]] || { echo "$stow_missing" >&2; exit 1; }
for package in "${packages[@]}"; do
  "$stow" --restow --no-folding --dir "${package%/home}" --target "$HOME" home
done

if [[ "$platform" == linux ]]; then
  # prepare builds the data in its own container home, outside the shared state.
  if ! $stow_only && [[ "${DEV_ENV_PREPARE:-}" != 1 ]]; then
    link_nvim_dirs
  fi
  stow_share
fi

if [[ -n "$backup_root" ]]; then
  echo "Configuration snapshots were copied to $backup_root"
fi
if $stow_only; then
  echo 'Configs restowed.'
else
  echo 'Bootstrap completed successfully.'
fi
