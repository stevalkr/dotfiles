#!/usr/bin/env bash
set -euo pipefail

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
home_package="$repo/home"
enable_remote_login=false
stow_only=false
usage() {
  echo 'usage: ./bootstrap [--enable-remote-login | --stow-only]'
}
while [[ $# -gt 0 ]]; do
  case "$1" in
    --enable-remote-login) enable_remote_login=true ;;
    --stow-only) stow_only=true ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done
if $stow_only && $enable_remote_login; then
  echo '--stow-only cannot be combined with --enable-remote-login' >&2; exit 2
fi

case "$(uname -s)" in
  Darwin)
    [[ "$(uname -m)" == arm64 ]] || { echo 'macOS requires Apple Silicon.' >&2; exit 2; }
    platform=macos
    stow=stow
    if $stow_only; then
      :
    elif $enable_remote_login; then
      "$repo/macos/bootstrap" --enable-remote-login
    else
      "$repo/macos/bootstrap"
    fi
    export PATH="/opt/homebrew/bin:$PATH"
    command -v stow >/dev/null 2>&1 || { echo 'Install Stow before running bootstrap.' >&2; exit 1; }
    ;;
  Linux)
    $enable_remote_login && { echo '--enable-remote-login is only supported on macOS' >&2; exit 2; }
    platform=linux
    dev_env="$HOME/.local/share/dev-env"
    stow="$dev_env/public/bin/stow"
    [[ -x "$stow" ]] || { echo 'Run ./linux/install first.' >&2; exit 1; }
    ;;
  *) echo 'Unsupported platform' >&2; exit 2 ;;
esac

restow() {
  "$stow" --restow --no-folding --dir "$repo" --target "$HOME" home
  "$stow" --restow --no-folding --dir "$repo/$platform" --target "$HOME" home
}

if $stow_only; then
  restow
  echo 'Configs restowed.'
  exit 0
fi

mkdir -p "$HOME/.dotfiles-backup"
backup_root=$(mktemp -d "$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S).XXXXXX")
backed_up=false

backup_config() {
  local destination="$HOME/$1"
  local backup_destination="$backup_root/$1"
  [[ -e "$destination" || -L "$destination" ]] || return 0

  mkdir -p "$(dirname "$backup_destination")"
  cp -RLp "$destination" "$backup_destination"
  rm -rf -- "$destination"
  printf 'backed up %s\n' "$destination"
  backed_up=true
}

backup_config_roots() {
  local package=$1
  local source

  [[ -d "$package/.config" ]] || return 0
  while IFS= read -r -d '' source; do
    backup_config ".config/${source##*/}"
  done < <(find "$package/.config" -mindepth 1 -maxdepth 1 -print0)
}

backup_config_roots "$home_package"
backup_config_roots "$repo/$platform/home"
if [[ "$platform" == macos ]]; then
  backup_config .zprofile
fi

for ssh_config in "$HOME/.ssh/config" "$HOME/.ssh/config.local"; do
  if [[ -e "$ssh_config" || -L "$ssh_config" ]]; then
    rm -f -- "$ssh_config.bak"
    cp -RLp "$ssh_config" "$ssh_config.bak"
    rm -f -- "$ssh_config"
  fi
done

rm -f -- "$HOME/.local/bin/multiplexer"

link_dir() {
  local path="$HOME/$1" target=$2
  [[ -L "$path" && "$(readlink -- "$path")" == "$target" ]] && return 0
  if [[ -e "$path" || -L "$path" ]]; then
    mkdir -p "$(dirname "$backup_root/$1")"
    mv -- "$path" "$backup_root/$1"
    printf 'backed up %s\n' "$path"
    backed_up=true
  fi
  mkdir -p "$(dirname "$path")"
  ln -sfn -- "$target" "$path"
  printf 'linked %s -> %s\n' "$path" "$target"
}

# Neovim state (undo, ShaDa, swap) is shared by every machine on the checkout;
# its data is the current release's prepared copy, so it follows ./linux/install.
link_nvim_dirs() {
  local state="$repo/linux/out/state/nvim"
  if [[ ! -e "$state" ]]; then
    mkdir -p "$(dirname "$state")"
    if [[ -d "$HOME/.local/state/nvim" && ! -L "$HOME/.local/state/nvim" ]]; then
      mv -- "$HOME/.local/state/nvim" "$state"
      echo "moved $HOME/.local/state/nvim to $state"
    else
      mkdir "$state"
    fi
  fi
  link_dir .local/state/nvim "$state"

  [[ -d "$dev_env/local/share/nvim" ]] ||
    { echo 'The current release has no Neovim data; run ./linux/install.' >&2; exit 1; }
  link_dir .local/share/nvim dev-env/local/share/nvim
}
# prepare builds the data in its own container home, outside the shared state.
if [[ "$platform" == linux && "${DEV_ENV_PREPARE:-}" != 1 ]]; then
  link_nvim_dirs
fi

if $backed_up; then
  echo "Configuration snapshots were copied to $backup_root"
else
  rmdir "$backup_root" 2>/dev/null || true
fi

restow

echo 'Bootstrap completed successfully.'
