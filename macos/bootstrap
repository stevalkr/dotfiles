#!/usr/bin/env bash
set -euo pipefail

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
brewfile="$repo/macos/Brewfile"
enable_remote_login=false

usage() {
  echo 'usage: ./macos/bootstrap [--enable-remote-login]'
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --enable-remote-login) enable_remote_login=true ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

[[ "$(uname -s)" == Darwin && "$(uname -m)" == arm64 ]] || {
  echo 'macOS provisioning requires Apple Silicon.' >&2; exit 2;
}
brew_shellenv=$(/opt/homebrew/bin/brew shellenv bash)
eval "$brew_shellenv"
brew bundle --file "$brewfile"

runtime_root="${XDG_DATA_HOME:-$HOME/.local/share}/nvim"
python_provider="$runtime_root/python"
if [[ ! -x "$python_provider/bin/python" ]]; then
  uv python install 3.13
  uv venv --managed-python --python 3.13 "$python_provider"
fi
uv pip install --python "$python_provider/bin/python" \
  pynvim \
  jupyter-client \
  cairosvg \
  pnglatex \
  plotly \
  kaleido \
  pyperclip \
  nbformat \
  pillow \
  requests \
  websocket-client

node_root="$runtime_root/node"
export FNM_DIR="$node_root/fnm"
fnm_shellenv=$(fnm env --shell bash)
eval "$fnm_shellenv"
fnm install --lts --use
npm install --prefix "$node_root/packages" --no-save --no-package-lock \
  neovim \
  markdownlint-cli \
  @fsouza/prettierd \
  pyright
mkdir -p "$node_root/bin"
node_path=$(node -p 'process.execPath')
ln -sfn "$node_path" "$node_root/bin/node"

if $enable_remote_login; then
  "$repo/macos/defaults.sh" --enable-remote-login
else
  "$repo/macos/defaults.sh"
fi

echo 'macOS provisioning completed successfully.'
