#!/usr/bin/env bash
set -euo pipefail
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/scripts/_common.sh"

if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then
    echo 'Usage: ./linux/pack'
    echo 'Export the locked build to out/packages/{metadata.tar.zst,mirror,SHA256SUMS}.'
    exit 0
fi
(($# == 0)) || { echo 'pack takes no arguments' >&2; exit 2; }

if [[ "${DEV_ENV_CONTAINER_PACK:-}" == 1 ]]; then
    enter_container_user "$@"
    lock=/opt/dev-env-spack-environment/spack.lock
    test -f "$lock"
    test "$(git -C /opt/dev-env-pinned-sources/spack rev-parse HEAD)" = "$SPACK_COMMIT"
    test "$(git -C /opt/dev-env-pinned-sources/spack-packages rev-parse HEAD)" = "$SPACK_PACKAGES_COMMIT"
    # Keep older mirror objects: subsequent transfers reuse their stable filenames.
    spack -e /opt/dev-env-spack-environment buildcache push \
        --unsigned --private --with-build-dependencies \
        file:///opt/dev-env-packages/mirror
    spack buildcache update-index -y file:///opt/dev-env-packages/mirror

    bootstrap_identity="${SPACK_COMMIT}-${SPACK_PACKAGES_COMMIT}-${BUILD_PLATFORM}"
    if [[ ! -f /opt/dev-env-offline-bootstrap/identity ]] || \
        [[ "$(cat /opt/dev-env-offline-bootstrap/identity)" != "$bootstrap_identity" ]]; then
        staging_bootstrap=$(mktemp -d /opt/dev-env-offline-bootstrap/.prepare.XXXXXXXX)
        spack bootstrap mirror --binary-packages "$staging_bootstrap"
        printf '%s\n' "$bootstrap_identity" >"$staging_bootstrap/identity"
        find /opt/dev-env-offline-bootstrap -mindepth 1 -maxdepth 1 \
            ! -name "$(basename "$staging_bootstrap")" -exec rm -rf -- {} +
        cp -a "$staging_bootstrap/." /opt/dev-env-offline-bootstrap/
        rm -rf -- "$staging_bootstrap"
    fi

    staging=$(mktemp -d /opt/dev-env-packages/.metadata.XXXXXXXX)
    trap 'rm -rf -- "$staging"' EXIT
    mkdir -p "$staging/metadata/environment" "$staging/metadata/repos"
    copy_sources() {
        mkdir -p "$2"
        tar -C "$1" --exclude=.git --exclude=__pycache__ --exclude='*.py[co]' \
            -cf - . | tar -C "$2" -xf -
    }
    copy_sources /opt/dev-env-pinned-sources/spack "$staging/metadata/spack"
    copy_sources /opt/dev-env-pinned-sources/spack-packages "$staging/metadata/repos/spack-packages"
    copy_sources "$project_root/repo/spack_repo/dev_env" "$staging/metadata/repos/spack_repo/dev_env"
    cp -a /opt/dev-env-offline-bootstrap "$staging/metadata/bootstrap"
    cp -a "$project_root/scripts" "$project_root/config" "$staging/metadata/"
    cp /opt/dev-env-spack-environment/spack.{yaml,lock} "$staging/metadata/environment/"
    cp "$project_root/config/spack-pins.env" "$staging/metadata/environment/"
    zstd_bin=$(spack -e /opt/dev-env-spack-environment location -i zstd)/bin/zstd
    tar --sort=name --mtime='UTC 1970-01-01' --owner=0 --group=0 --numeric-owner \
        -C "$staging" -I "$zstd_bin -T0 -19" -cf "$staging/metadata.tar.zst" metadata
    mv "$staging/metadata.tar.zst" /opt/dev-env-packages/metadata.tar.zst
    cd /opt/dev-env-packages
    # Publish the manifest last. Transfer it last too, after changed cache objects.
    { sha256sum metadata.tar.zst;
      find mirror -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum;
    } >"$staging/SHA256SUMS"
    mv "$staging/SHA256SUMS" SHA256SUMS
    echo 'Offline package inputs: linux/out/packages/'
    exit 0
fi

require_command docker
prepare_output_tree
test -f "$manifest_root/build-completed-at.txt" || { echo 'Run ./linux/build first' >&2; exit 1; }
# A modified source tree needs a new build before packing.
(cd "$project_root" && sha256sum -c --quiet "$manifest_root/build-inputs.sha256")
prepare_proxy_environment
prepare_docker_network
docker run --rm --platform "$BUILD_PLATFORM" \
    "${docker_network_run_args[@]}" "${docker_proxy_run_args[@]}" \
    --security-opt label=disable \
    --volume "$project_root:/opt/dev-env:ro" \
    --volume "$build_root/store:/opt/padded-spack-store" \
    --volume "$spack_environment:/opt/dev-env-spack-environment" \
    --volume "$environment_root:/opt/dev-env-root:ro" \
    --volume "$source_cache:/opt/dev-env-pinned-sources:ro" \
    --volume "$bundle_root:/opt/dev-env-packages" \
    --volume "$offline_bootstrap_root:/opt/dev-env-offline-bootstrap" \
    --volume "$cache_root/bootstrap:/opt/dev-env-bootstrap" \
    --volume "$cache_root/misc:/opt/dev-env-misc-cache" \
    --volume "$cache_root/sources:/opt/dev-env-source-cache" \
    --volume "$build_root/stage:/opt/dev-env-build-stage" \
    --env DEV_ENV_CONTAINER_PACK=1 --env HOME=/tmp/dev-env-pack-home \
    --env DEV_ENV_HOST_UID="$(id -u)" --env DEV_ENV_HOST_GID="$(id -g)" \
    "$builder_image" bash /opt/dev-env/pack 2>&1 | tee "$log_root/pack.log"
