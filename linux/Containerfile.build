ARG BUILD_IMAGE_REF
FROM ${BUILD_IMAGE_REF}

ARG SPACK_COMMIT
ARG SPACK_PACKAGES_COMMIT
ARG BUILD_IMAGE_DIGEST
ARG BUILD_PLATFORM
ARG BUILDER_DEFINITION_SHA256

LABEL org.opencontainers.image.title="dev-env build environment"
LABEL org.opencontainers.image.description="EL8-compatible builder for the portable offline dev-env"
LABEL dev-env.spack-commit="$SPACK_COMMIT"
LABEL dev-env.spack-packages-commit="$SPACK_PACKAGES_COMMIT"
LABEL dev-env.build-image-digest="$BUILD_IMAGE_DIGEST"
LABEL dev-env.build-platform="$BUILD_PLATFORM"
LABEL dev-env.builder-definition-sha256="$BUILDER_DEFINITION_SHA256"

WORKDIR /opt/dev-env

COPY container/rocky-8.7-vault.repo /etc/yum.repos.d/dev-env-rocky-8.7.repo

RUN sed -i 's/^enabled=1/enabled=0/' /etc/yum.repos.d/Rocky-*.repo \
    && dnf -y install \
        bzip2 \
        ca-certificates \
        curl \
        diffutils \
        file \
        findutils \
        gcc \
        gcc-c++ \
        gcc-gfortran \
        git \
        gnupg2 \
        gzip \
        make \
        patch \
        python3 \
        shadow-utils \
        tar \
        unzip \
        util-linux \
        which \
        xz \
    && dnf clean all \
    && rm -rf /var/cache/dnf

COPY out/sources/spack/ /opt/spack/
COPY out/sources/spack-packages/ /opt/spack-packages/

RUN test "$(git -C /opt/spack rev-parse HEAD)" = "$SPACK_COMMIT" \
    && test "$(git -C /opt/spack-packages rev-parse HEAD)" = "$SPACK_PACKAGES_COMMIT"

COPY config/ /opt/dev-env/config/
COPY repo/ /opt/dev-env/repo/
COPY spack.yaml /opt/dev-env/spack.yaml

ENV PYTHONDONTWRITEBYTECODE=1 \
    SPACK_ROOT=/opt/spack \
    SPACK_PYTHON=/usr/bin/python3 \
    SPACK_USER_CONFIG_PATH=/opt/dev-env/config \
    SPACK_SYSTEM_CONFIG_PATH=/opt/dev-env-system-config \
    PATH=/opt/spack/bin:${PATH}

RUN mkdir -p \
        /opt/dev-env-bootstrap \
        /opt/dev-env-build-stage \
        /opt/dev-env-misc-cache \
        /opt/dev-env-source-cache \
        /opt/dev-env-system-config \
        /opt/padded-spack-store \
    && spack --version \
    && spack repo list

CMD ["/bin/bash", "--login"]
