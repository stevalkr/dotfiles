#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=lib.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"

case "${1:-}" in
    -h|--help)
        printf '%s\n' 'Usage: ./linux/build' \
            'Build the packages, push the release mirror and write the release files.'
        exit 0 ;;
    "") ;;
    *) die 'build takes no arguments' ;;
esac
need docker git sha256sum

# clone_pinned <name> <url> <tag> <commit>
clone_pinned() {
    local destination=$cache/src/$1 url=$2 tag=$3 commit=$4
    if [[ ! -d "$destination/.git" ]]; then
        [[ ! -e "$destination" ]] || die "$destination exists but is not a Git checkout"
        git clone --depth 1 --branch "$tag" "$url" "$destination"
    fi
    [[ -z "$(git -C "$destination" status --porcelain)" ]] || die "modified checkout: $destination"
    if [[ "$(git -C "$destination" rev-parse HEAD)" != "$commit" ]]; then
        [[ "$(git -C "$destination" remote get-url origin)" == "$url" ]] ||
            die "$destination has an unexpected origin"
        git -C "$destination" fetch --depth 1 origin "$commit"
        git -C "$destination" checkout --detach "$commit"
    fi
    [[ "$(git -C "$destination" rev-parse HEAD)" == "$commit" ]] || die "$destination is not at $commit"
}

clone_pinned spack "$SPACK_GIT_URL" "$SPACK_TAG" "$SPACK_COMMIT"
clone_pinned spack-packages "$SPACK_PACKAGES_GIT_URL" "$SPACK_PACKAGES_TAG" "$SPACK_PACKAGES_COMMIT"
ensure_image

mkdir -p "$cache"/{store,stage,sources,misc,bootstrap,home,env} "$dist/packages/mirror"
printf 'build: log %s\n' "$cache/build.log"
docker_run \
    --volume "$linux_root/spack:/opt/dev-env/spack:ro" \
    --volume "$linux_root/scripts:/opt/dev-env/scripts:ro" \
    --volume "$cache/src/spack:/opt/spack:ro" \
    --volume "$cache/src/spack-packages:/opt/spack-packages:ro" \
    --volume "$cache/store:/opt/padded-spack-store" \
    --volume "$cache/stage:/opt/dev-env-build-stage" \
    --volume "$cache/sources:/opt/dev-env-source-cache" \
    --volume "$cache/misc:/opt/dev-env-misc-cache" \
    --volume "$cache/bootstrap:/opt/dev-env-bootstrap" \
    --volume "$cache/home:/opt/dev-env-home" \
    --volume "$cache/env:/opt/dev-env-env" \
    --volume "$dist/packages:/opt/dev-env-dist/packages" \
    --env HOME=/opt/dev-env-home \
    -- bash /opt/dev-env/scripts/build.sh 2>&1 | tee "$cache/build.log"
printf 'build: release files in %s\n' "$dist/packages"
