#!/usr/bin/env bash
set -euo pipefail
view=$HOME/.local/share/dev-env/view
[[ -x "$view/bin/nvim" ]] || { echo 'nvim: run ./linux/install first' >&2; exit 127; }
# Providers and their interpreters stay private to Neovim's process tree.
export NVIM_PYTHON_PROVIDER="$view/bin/python3"
export NVIM_NODE_PROVIDER="$view/bin/neovim-node-host"
export PATH="$view/bin${PATH:+:$PATH}"
exec "$view/bin/nvim" \
    --cmd 'let g:python3_host_prog = $NVIM_PYTHON_PROVIDER | let g:node_host_prog = $NVIM_NODE_PROVIDER' \
    "$@"
