[include]
	path = ~/.config/git/config.local

[alias]
	cm = commit
	ll = logline
	logline = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	st = status

[commit]
	gpgSign = false

[core]
	editor = nvim

[gpg]
	format = ssh

[init]
	defaultBranch = main

[tag]
	gpgSign = false

