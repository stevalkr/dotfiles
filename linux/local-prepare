#!/usr/bin/env bash
set -euo pipefail
linux_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
case "${1:-}" in
    -h|--help) echo 'Usage: ./linux/local-prepare (connected Linux container)'; exit 0 ;;
esac
(($# == 0)) || { echo 'local-prepare takes no arguments' >&2; exit 2; }
if [[ "${DOTFILES_LINUX_CONTAINER:-}" != 1 ]]; then
    exec "$linux_root/test" -- /opt/dotfiles/linux/local-prepare
fi
[[ "$(uname -s)" == Linux && "$(uname -m)" == x86_64 ]] || exit 2
[[ -z "${XDG_CONFIG_HOME:-}" && -z "${XDG_DATA_HOME:-}" && -z "${XDG_STATE_HOME:-}" ]] || {
    echo 'Prepare the default XDG layout for portable local data.' >&2; exit 2;
}
rm -f "$HOME/.local/share/dotfiles-linux/prepared.json"
# Run the user's normal startup and build hooks. Leave the session open until
# plugin/parser preparation finishes, then quit to verify the prepared assets.
echo 'Wait for Neovim plugin/parser builds to finish, then quit to complete preparation.'
nvim
nvim --headless -c "lua vim.schedule(function() dofile('$linux_root/scripts/prepare-nvim.lua') end)"
mkdir -p "$HOME/.local/share/dotfiles-linux"
python3 - "$HOME/.local/share/dotfiles-linux/prepared.json" <<'PY'
import json, os, pathlib, platform, sys
pathlib.Path(sys.argv[1]).write_text(json.dumps({
    'platform': platform.system(), 'architecture': platform.machine(),
    'home': os.environ['HOME'], 'prefix': os.environ['DEV_ENV_ROOT'],
}) + '\n')
PY
echo 'Prepared Linux runtime data. Run ./linux/local-pack on the host.'
