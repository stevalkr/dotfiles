#!/usr/bin/env bash
set -euo pipefail

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
home_package="$repo/home"
brewfile="$repo/macos/Brewfile"

if ! command -v brew >/dev/null 2>&1; then
  brew_shellenv=$(/opt/homebrew/bin/brew shellenv bash)
  eval "$brew_shellenv"
fi
brew bundle check --verbose --file "$brewfile"
stow --simulate --verbose --no-folding --dir "$repo" --target "$HOME" home
stow --simulate --verbose --no-folding --dir "$repo/macos" --target "$HOME" home

test "$(readlink "$home_package/.local/bin/multiplexer")" = \
  '../../.config/nvim/dev/multiplexer.nvim/scripts/multiplexer'
test -x "$HOME/.local/bin/multiplexer"
test -x "${XDG_DATA_HOME:-$HOME/.local/share}/nvim/python/bin/python"
test -x "${XDG_DATA_HOME:-$HOME/.local/share}/nvim/node/bin/node"
test -x "${XDG_DATA_HOME:-$HOME/.local/share}/nvim/node/packages/node_modules/.bin/neovim-node-host"

if rg --hidden -n '/nix/store|/Users/walker|/opt/homebrew' "$repo/home" \
  --glob '!**/doc/**' \
  --glob '!**/readme.md'; then
  exit 1
fi

while IFS= read -r -d '' fish_file; do
  fish -n "$fish_file"
done < <(find "$home_package/.config/fish" -name '*.fish' -print0)

test "$(fish -lc 'printf dotfiles-startup-ok')" = dotfiles-startup-ok
test "$(zsh -lc 'printf dotfiles-startup-ok')" = dotfiles-startup-ok
git config --global --list --show-origin
ssh -G cloudcone >/dev/null

tmux_socket="dotfiles-test-$$"
trap 'tmux -L "$tmux_socket" kill-server 2>/dev/null || true' EXIT
tmux -L "$tmux_socket" -f "$HOME/.config/tmux/tmux.conf" new-session -d -s dotfiles-test
tmux -L "$tmux_socket" kill-server
trap - EXIT

wezterm --config-file "$HOME/.config/wezterm/wezterm.lua" ls-fonts >/dev/null
nvim --headless '+lua assert(vim.fn.executable("node") == 1, "Neovim cannot find node"); assert(vim.fn.executable("npm") == 1, "Neovim cannot find npm"); assert(vim.fn.executable(vim.g.node_host_prog) == 1, "Neovim cannot find its Node host")' '+qa'

state_home=${XDG_STATE_HOME:-"$HOME/.local/state"}
health_file="$state_home/dotfiles/nvim-checkhealth.txt"
mkdir -p "$(dirname "$health_file")"
nvim --headless '+checkhealth' "+silent write! $health_file" '+qa'

echo "All checks passed. Neovim health report: $health_file"
